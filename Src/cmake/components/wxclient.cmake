# Include order = 0.85 project order: ..\Common\ (now Engine/Interface), Common, Packets, DataBase, LuaPlus, Combat,
# Net, .\ (WXClient). "..\WxRender\RenderSystem.h" resolves through Engine/Interface/.. = Engine/WXRender.
target_include_directories(cys_wxclient PRIVATE
    "${CYS_SRC}/Engine/Interface"
    "${CYS_SRC}/Shared/Common"
    "${CYS_SRC}/Shared/Common/Packets"
    "${CYS_SRC}/Shared/Common/DataBase"
    "${CYS_TP}/LuaPlus/Src/LuaPlus"
    "${CYS_SRC}/Shared/Common/Combat"
    "${CYS_SRC}/Shared/Common/Net"
    "${_cys_wxcl}")
target_compile_definitions(cys_wxclient PRIVATE _MBCS _DISABLE_TRACE__)

# CYS: Lua host functions of the modern client that 0.85 lacks: generated stubs of the Lua-API agent
# (checked-in sources under Src/Client/LuaApiGen). Registered by CGameProcedure::InitStaticMemeber.
file(GLOB _cys_luaapigen CONFIGURE_DEPENDS "${CYS_SRC}/Client/LuaApiGen/*.cpp")
if(_cys_luaapigen)
    target_sources(cys_wxclient PRIVATE ${_cys_luaapigen})
    target_include_directories(cys_wxclient PRIVATE "${CYS_SRC}/Client/LuaApiGen")
    target_compile_definitions(cys_wxclient PRIVATE CYS_HAVE_LUAAPIGEN=1)
endif()
# DirectInput 8 (<dinput.h>, dinput8.lib, dxguid.lib) comes from the Windows SDK. The old DirectX 9 SDK include dir
# must not be on the /I path: its rpcsal.h/specstrings shadow the Windows SDK ones (C2061 __RPC__in_xcount in objidl.h).
target_link_libraries(cys_wxclient PRIVATE
    cys_wxnetpackets cys_wxengine
    dinput8 dxguid ws2_32 shlwapi winmm)
# CYS: navmesh *.path (SceneDefineEx col 5) through the clean-room PathLib.dll (Engine/PathLib), like B's Render.dll.
if(TARGET cys_pathlib)
    target_link_libraries(cys_wxclient PRIVATE cys_pathlib)
else()
    message(WARNING "CYS: cys_pathlib is not configured in this tree - Game.exe will not link (CysNavMesh needs PathLib.dll)")
endif()
# CYS: modern login transport and generated codec, kept separate from 0.85 packets.
if(TARGET cys_netcore)
    target_link_libraries(cys_wxclient PRIVATE cys_netcore)
    target_compile_definitions(cys_wxclient PRIVATE CYS_HAVE_NETCORE=1)
endif()
if(TARGET cys_luaplus)
    target_link_libraries(cys_wxclient PRIVATE cys_luaplus)
else()
    message(WARNING "CYS: cys_luaplus is not configured in this tree - Game.exe compiles but will not link")
endif()
if(TARGET cys_fmod)
    target_link_libraries(cys_wxclient PRIVATE cys_fmod)
    target_compile_definitions(cys_wxclient PRIVATE CYS_HAVE_FMOD=1)
    add_custom_command(TARGET cys_wxclient POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:cys_fmod>" "$<TARGET_FILE_DIR:cys_wxclient>"
        VERBATIM)
endif()
if(MSVC)
    # /EHa: WXClient.cpp mixes __try/__except (crash handler) with C++ exceptions thrown by TDThrow.
    target_compile_options(cys_wxclient PRIVATE /bigobj /w14311 /w14312 /w14302)
    set_source_files_properties("${_cys_wxcl}/WXClient.cpp" PROPERTIES COMPILE_OPTIONS "/EHa")
endif()

# Game.rc is GBK with #pragma code_page(936). Compiled by a custom command so the global C/C++ flags
# (/MP /Zi /source-charset ...) never reach rc.exe; the .res goes straight to the linker.
find_program(CYS_RC_EXE NAMES rc rc.exe HINTS "${CMAKE_RC_COMPILER}")
if(CYS_RC_EXE)
    set(_cys_wxcl_res "${CMAKE_CURRENT_BINARY_DIR}/cys_wxclient_Game.res")
    add_custom_command(OUTPUT "${_cys_wxcl_res}"
        COMMAND "${CYS_RC_EXE}" /nologo /l 0x804 /fo "${_cys_wxcl_res}" "${_cys_wxcl}/Game.rc"
        WORKING_DIRECTORY "${_cys_wxcl}"
        DEPENDS "${_cys_wxcl}/Game.rc" "${_cys_wxcl}/resource.h" "${CYS_SRC}/../TSGame.ico"
        COMMENT "rc Game.rc"
        VERBATIM)
    set_source_files_properties("${_cys_wxcl_res}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
    target_sources(cys_wxclient PRIVATE "${_cys_wxcl_res}")
endif()
set_target_properties(cys_wxclient PROPERTIES OUTPUT_NAME Game FOLDER Client)
