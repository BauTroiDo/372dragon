# CYS component: WXNetPackets - static library holding the 0.85 game protocol and the shared game code of
# Src/Shared/Common (packets, socket streams, DBC reader, GameStruct/DB_Struct serializers, combat templates).
# Old project: Client/WXNetPackets/WXNetPackets.vcxproj (409 sources, static, MultiByte, /MD). Its sources lived at
# ..\..\..\Common\... in 0.85 and now live in Src/Shared/Common; stdafx.cpp/stdafx.h stay in Client/WXNetPackets.
#
# cys_common_headers (INTERFACE): include dirs + the preprocessor switches that change struct layouts of the shared
#   headers (_FOX_SERVER/_FOX_CLIENT/_FOX_LOGIN/GAME_CLIENT/__WINDOWS__). Everything that includes Shared/Common
#   headers (WXNetPackets, Game.exe, the ABI dump tool) must see the same switches, so they are PUBLIC here.
# cys_abi_dump: Tests/abi/dump_sizes.cpp - prints sizeof/alignof/offsetof of every struct/class declared in
#   Shared/Common (Docs/04 section 6). Header-only, no link dependency, so it also builds in an x86 tree that only
#   configures this component: build.cmd x86 client-x86 Release wxnetpackets cys_abi_dump

set(_cys_cmn "${CYS_SRC}/Shared/Common")

if(NOT TARGET cys_common_headers)
    add_library(cys_common_headers INTERFACE)
    # Order = 0.85 project order (Common, Packets, DataBase, Net) + Combat (WXClient order has it before Net).
    target_include_directories(cys_common_headers INTERFACE
        "${_cys_cmn}"
        "${_cys_cmn}/Packets"
        "${_cys_cmn}/DataBase"
        "${_cys_cmn}/Combat"
        "${_cys_cmn}/Net")
    target_compile_definitions(cys_common_headers INTERFACE
        __WINDOWS__ _FOX_CLIENT _FOX_SERVER _FOX_LOGIN GAME_CLIENT)
endif()

