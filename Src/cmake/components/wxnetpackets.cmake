set(_cys_abi "${CYS_ROOT}/Tests/abi")
if(EXISTS "${_cys_abi}/dump_sizes.cpp")
    add_executable(cys_abi_dump "${_cys_abi}/dump_sizes.cpp")
    target_include_directories(cys_abi_dump PRIVATE "${_cys_abi}" "${CYS_SRC}/Client/WXNetPackets")
    target_compile_definitions(cys_abi_dump PRIVATE _MBCS _CONSOLE)
    target_link_libraries(cys_abi_dump PRIVATE cys_common_headers)
    if(MSVC)
        target_compile_options(cys_abi_dump PRIVATE /bigobj)
    endif()
    set_target_properties(cys_abi_dump PROPERTIES OUTPUT_NAME abi_dump FOLDER Tests)
endif()
