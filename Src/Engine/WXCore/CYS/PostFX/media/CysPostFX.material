// CY-Source post-processing media (Docs/specs/render/02-postfx.md), loaded by WX::CysPostFx::initialiseMedia().
// One keyword per line, TAB indentation (0.85 line-based MaterialSerializer), no trailing comments.
// Programs whose source is not in this folder use B's HLSL from client_GL Data\MaterialTemplates.zip (read-only):
// AntiAlias.hlsl, Bloom.hlsl, CopyFrameBuffer.hlsl, ColorLUT.hlsl, GodRays.hlsl, GaussianBlur.hlsl,
// DepthOfField.hlsl, HeightFog_vs.hlsl, HeightFog_ps.hlsl. Constants without a default are set per frame in C++.

//==================================================================================================== programs
vertex_program CysPostFX/QuadVS hlsl
{
	source CysPostFx_vs.hlsl
	entry_point quad_vs
	target vs_3_0
	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
	}
}

fragment_program CysPostFX/CopyFP hlsl
{
	source CysPostFxCopy.hlsl
	entry_point copy_ps
	target ps_3_0
}

fragment_program CysPostFX/FinalFP hlsl
{
	source CysPostFxCopy.hlsl
	entry_point final_ps
	target ps_3_0
	default_params
	{
		param_named ditherAmount float 1
	}
}

fragment_program CysPostFX/DepthClearFP hlsl
{
	source CysPostFxCopy.hlsl
	entry_point depthclear_ps
	target ps_3_0
	default_params
	{
		param_named farValue float 50000
	}
}

fragment_program CysPostFX/HDR/LumInitFP hlsl
{
	source CysHdr.hlsl
	entry_point lumInit_ps
	target ps_3_0
}

fragment_program CysPostFX/HDR/LumDownFP hlsl
{
	source CysHdr.hlsl
	entry_point lumDown_ps
	target ps_3_0
}

fragment_program CysPostFX/HDR/LumAdaptFP hlsl
{
	source CysHdr.hlsl
	entry_point lumAdapt_ps
	target ps_3_0
}

fragment_program CysPostFX/HDR/FinalLdrFP hlsl
{
	source CysHdr.hlsl
	entry_point final_ps
	target ps_3_0
	preprocessor_defines USE_HDR=0;USE_AUTOEXPOSURE=0
}

fragment_program CysPostFX/HDR/FinalHdrFP hlsl
{
	source CysHdr.hlsl
	entry_point final_ps
	target ps_3_0
	preprocessor_defines USE_HDR=1;USE_AUTOEXPOSURE=0
}

fragment_program CysPostFX/HDR/FinalHdrAutoFP hlsl
{
	source CysHdr.hlsl
	entry_point final_ps
	target ps_3_0
	preprocessor_defines USE_HDR=1;USE_AUTOEXPOSURE=1
}

fragment_program CysPostFX/HDR/ToLinearClampFP hlsl
{
	source CysHdr.hlsl
	entry_point toLinearClamp_ps
	target ps_3_0
}

fragment_program CysPostFX/SSAO/GenFP hlsl
{
	source CysSSAO.hlsl
	entry_point genAO_ps
	target ps_3_0
}

fragment_program CysPostFX/SSAO/BlurFP hlsl
{
	source CysSSAO.hlsl
	entry_point blur_ps
	target ps_3_0
}

fragment_program CysPostFX/SSAO/ApplyFP hlsl
{
	source CysSSAO.hlsl
	entry_point apply_ps
	target ps_3_0
}

fragment_program CysPostFX/GodRays/MaskFP hlsl
{
	source CysGodRays.hlsl
	entry_point mask_ps
	target ps_3_0
}

//---------------------------------------------------------------------------------------- depth node programs
vertex_program CysPostFX/Depth/VS_W0 hlsl
{
	source CysDepth.hlsl
	entry_point depth_vs
	target vs_3_0
	preprocessor_defines CYS_WEIGHTS=0;CYS_UV=0
	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
		param_named_auto worldView worldview_matrix
	}
}

vertex_program CysPostFX/Depth/VS_W0_UV hlsl
{
	source CysDepth.hlsl
	entry_point depth_vs
	target vs_3_0
	preprocessor_defines CYS_WEIGHTS=0;CYS_UV=1
	default_params
	{
		param_named_auto worldViewProj worldviewproj_matrix
		param_named_auto worldView worldview_matrix
	}
}

vertex_program CysPostFX/Depth/VS_W1 hlsl
{
	source CysDepth.hlsl
	entry_point depth_vs
	target vs_3_0
	includes_skeletal_animation true
	preprocessor_defines CYS_WEIGHTS=1;CYS_UV=0
	default_params
	{
		param_named_auto worldMatrix3x4Array[0] world_matrix_array_3x4
		param_named_auto viewProj viewproj_matrix
		param_named_auto view view_matrix
	}
}

