// CYS-PARITY (L2): unit 1 = INTZ scene depth (content_type dsintz), linearised in the shader (near/far set per frame)
material CysPostFX/HeightFog_DSIntZ
{
	technique
	{
		pass
		{
			lighting off
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			fog_override true
			vertex_program_ref CysPostFX/B/HeightFogVS
			{
			}
			fragment_program_ref CysPostFX/B/HeightFogFP_DSIntZ
			{
			}
			texture_unit
			{
				tex_address_mode clamp
				filtering none
			}
			texture_unit
			{
				tex_address_mode clamp
				filtering none
				content_type dsintz
			}
		}
	}
}

