	}
}

//------------------------------------------------------------------------- B programs (MaterialTemplates.zip)
fragment_program CysPostFX/B/ToLinearFP hlsl
{
	source CopyFrameBuffer.hlsl
	entry_point ConvertToLinearSpace
	target ps_3_0
}

fragment_program CysPostFX/B/BrightpassFP hlsl
{
	source Bloom.hlsl
	entry_point DownsampleBrightpassFp
	target ps_3_0
	default_params
	{
		param_named_auto viewport_size viewport_size
		param_named threshold float4 1 0.5 1 0.5
	}
}

fragment_program CysPostFX/B/DownFP hlsl
{
	source Bloom.hlsl
	entry_point DownsampleFp
	target ps_3_0
	default_params
	{
		param_named_auto viewport_size viewport_size
	}
}

fragment_program CysPostFX/B/UpFP hlsl
{
	source Bloom.hlsl
	entry_point UpsampleFp
	target ps_3_0
	default_params
	{
		param_named_auto viewport_size viewport_size
		param_named sampleScale float 1
	}
}

fragment_program CysPostFX/B/FXAANoLumaFP hlsl
{
	source AntiAlias.hlsl
	entry_point FXAA_PS_NOLUMA
	target ps_3_0
	default_params
	{
		param_named_auto viewportSize viewport_size
	}
}

fragment_program CysPostFX/B/FXAALumaFP hlsl
{
	source AntiAlias.hlsl
	entry_point FXAA_PS_LUMA
	target ps_3_0
}

fragment_program CysPostFX/B/FXAAQualityFP hlsl
{
	source AntiAlias.hlsl
	entry_point FXAA_PS_Quality
	target ps_3_0
	default_params
	{
		param_named_auto viewportSize viewport_size
	}
}

fragment_program CysPostFX/B/DLAAEdgeFP hlsl
{
	source AntiAlias.hlsl
	entry_point DLAA_EdgeDetectionPS
	target ps_3_0
	default_params
	{
		param_named_auto cTargetSize viewport_size
	}
}

fragment_program CysPostFX/B/DLAABlendFP hlsl
{
	source AntiAlias.hlsl
	entry_point DLAA_BlendingColorPS
	target ps_3_0
	default_params
	{
		param_named_auto cTargetSize viewport_size
	}
}

fragment_program CysPostFX/B/ColorLUTFP hlsl
{
	source ColorLUT.hlsl
	entry_point colorLUT_fp
	target ps_3_0
	default_params
	{
		param_named dest_amount float 1
	}
}

vertex_program CysPostFX/B/HeightFogVS hlsl
{
	source HeightFog_vs.hlsl
	entry_point main
	target vs_3_0
	column_major_matrices false
	default_params
	{
		param_named_auto worldviewproj_matrix worldviewproj_matrix
	}
}

fragment_program CysPostFX/B/HeightFogFP hlsl
{
	source HeightFog_ps.hlsl
	entry_point main
	target ps_3_0
	column_major_matrices false
	default_params
	{
		param_named_auto cTargetSize viewport_size
	}
}

// CYS-PARITY (L2): CY PostFilters/HeightFog_DSIntZ - HeightFog_ps.hlsl with USE_DSINTZ=1 on the INTZ scene depth
fragment_program CysPostFX/B/HeightFogFP_DSIntZ hlsl
{
	source HeightFog_ps.hlsl
	entry_point main
	target ps_3_0
	column_major_matrices false
	preprocessor_defines USE_DSINTZ=1
	default_params
	{
		param_named_auto cTargetSize viewport_size
	}
}

fragment_program CysPostFX/B/GodRaysGenFP hlsl
{
	source GodRays.hlsl
	entry_point genGodRays_fp
	target ps_3_0
}

fragment_program CysPostFX/B/GodRaysAddFP hlsl
{
	source GodRays.hlsl
	entry_point addGodRays_fp
	target ps_3_0
}

fragment_program CysPostFX/B/BlurFP hlsl
{
	source GaussianBlur.hlsl
	entry_point psGaussianBlur
	target ps_3_0
	default_params
	{
		param_named_auto vvp viewport_size
		param_named offset float2 1 0
		param_named fStrength float 1
	}
}

fragment_program CysPostFX/B/DoFBlurFP hlsl
{
	source DepthOfField.hlsl
	entry_point DoF_Gaussian3x3FP
	target ps_3_0
	default_params
	{
		param_named pixelSize float 0.001
	}
}

fragment_program CysPostFX/B/DoFCombineFP hlsl
{
	source DepthOfField.hlsl
	entry_point DoF_DepthOfFieldFP
	target ps_3_0
	default_params
	{
		param_named pixelSizeScene float 0.0005
		param_named pixelSizeBlur float 0.001
		param_named dofParams float4 0.3 500 1000 0.3
	}
}

//==================================================================================================== materials
material CysPostFX/Final
{
	technique
	{
		pass
		{
			lighting off
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			fog_override true
			vertex_program_ref CysPostFX/QuadVS
			{
			}
			fragment_program_ref CysPostFX/FinalFP
			{
			}
			texture_unit
			{
				tex_address_mode clamp
				filtering none
			}
		}
	}
}

material CysPostFX/Copy
{
	technique
	{
		pass
		{
			lighting off
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			fog_override true
			vertex_program_ref CysPostFX/QuadVS
			{
			}
			fragment_program_ref CysPostFX/CopyFP
			{
			}
			texture_unit
			{
				tex_address_mode clamp
				filtering none
			}
		}
	}
}

material CysPostFX/DepthClear
{
	technique
	{
		pass
		{
			lighting off
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			fog_override true
			vertex_program_ref CysPostFX/QuadVS
			{
			}
			fragment_program_ref CysPostFX/DepthClearFP
			{
			}
		}
	}
}

