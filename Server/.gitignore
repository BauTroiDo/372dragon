# CY-Source private server (/home/ubuntu/cys-test-20260913): scripts and configuration only.
# Runtime state, secrets, generated files and large binaries stay out of git.
/db/
/log/
/lifecycle-backups/
/backups/
*.pid
nohup_*.out
/account-created.json
# DB credentials: tracked as a redacted template (server_conf.lua.example) only.
/confs/publish_yu/server_conf.lua
# Generated by config_maker.lua at every start.
/GameServer/config_[0-9]*
# Generated native binaries; source dependencies are included in this export.
/GameServer/luaclib/
/GameServer/cservice/
*.so
*.so.*
*.a
*.o
*.axp
# Historical scene patterns; the public root .gitignore excludes all external scene data.
/Game_2/Scene/**/*.path
/Game_2/Scene/**/*.stall
/Game_2/Scene/**/*.nav
# Ad-hoc backup copies made before git existed.
*.bak
*.bak-*
*.bak.*
*.mapbak-*
*.pre-count-*
*.pre-debug
*.vmware.bak
