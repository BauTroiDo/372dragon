function scenecore:gen_obj_id()
	local reset_num = 0
    while true do
        self.now_obj_id = self.now_obj_id + 1
        local now = self.now_obj_id
        if now >= define.MAX_OBJ_ID then
            self.now_obj_id = 1
			reset_num = reset_num + 1
			if reset_num > 1 then
				return
			end
        elseif not self.objs[now] then
            return now
        end
    end
end

