            msg.error_code = define.PLAYER_SHOP_ERR.ERR_NEED_NEW_COPY
            self:send2client(obj_me, msg)
            return
        end
        if not stall_box:can_sale(index_in_stall) then
            msg.error_code = define.PLAYER_SHOP_ERR.ERR_NEED_NEW_COPY
            self:send2client(obj_me, msg)
            return
