                            if chage_item then
                                local change = packet_def.GCItemInfo.new()
                                change.askid = 0
                                change.bagIndex = msg.bag_index
                                change.unknow_1 = 0
                                change.unknow_2 = 0
            
                                local raw_data = item:copy_raw_data()
